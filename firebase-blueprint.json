{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing roles, points, and member personal details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phone": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "operator"] },
        "points": { "type": "number" },
        "gender": { "type": "string", "enum": ["male", "female", "other", "undisclosed"] },
        "birthDate": { "type": "string" },
        "address": { "type": "string" },
        "favPickup": { "type": "string" },
        "favDropoff": { "type": "string" },
        "avatarDataUrl": { "type": "string" },
        "welcomeBonusGranted": { "type": "boolean" },
        "welcomeBonusPoints": { "type": "number" },
        "welcomeBonusAt": { "type": "string" },
        "rewardedBookingIds": { "type": "array" },
        "completedBookingsCount": { "type": "number" },
        "usedCoupons": { "type": "array" }
      },
      "required": ["id", "role"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Ticket booking for limousine, combos, car",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "bookingDate": { "type": "string" },
        "travelDate": { "type": "string" },
        "passengerName": { "type": "string" },
        "passengerPhone": { "type": "string" },
        "totalPrice": { "type": "number" },
        "depositAmount": { "type": "number" },
        "operatorNotes": { "type": "string" },
        "driverName": { "type": "string" },
        "driverPhone": { "type": "string" },
        "vehiclePlate": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId", "type", "status"]
    },
    "BlockedSeat": {
      "title": "BlockedSeat",
      "description": "Information about locked seats by operator or booked",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tripId": { "type": "string" },
        "travelDate": { "type": "string" },
        "seatId": { "type": "string" },
        "customerPhone": { "type": "string" },
        "lockedBy": { "type": "string" }
      },
      "required": ["id", "tripId", "travelDate", "seatId"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Driver and vehicle fleet information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "plate": { "type": "string" },
        "carType": { "type": "string" },
        "note": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "busy", "off"] }
      },
      "required": ["id", "name", "phone", "plate"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional vouchers and discounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "discountPercentage": { "type": "number" },
        "title": { "type": "string" },
        "audience": { "type": "string" },
        "validFrom": { "type": "string" },
        "validUntil": { "type": "string" },
        "birthdayWindow": { "type": "string" },
        "minAge": { "type": "number" },
        "maxAge": { "type": "number" },
        "usageLimit": { "type": "number" },
        "usageCount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "isPublished": { "type": "boolean" }
      },
      "required": ["id", "code", "discountPercentage"]
    },
    "Config": {
       "title": "Config",
       "description": "Global config models for coupons, combos, articles, etc",
       "type": "object",
       "properties": {}
    },
    "Review": {
      "title": "Review",
      "description": "Customer reviews for destinations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "destinationId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userAvatar": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "destinationId", "userName", "rating", "comment", "timestamp"]
    },
    "ZaloGroup": {
      "title": "ZaloGroup",
      "description": "Zalo community room information and invite link",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "topic": { "type": "string" },
        "description": { "type": "string" },
        "zaloUrl": { "type": "string" },
        "iconEmoji": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "zaloUrl", "isActive"]
    }
  },
  "firestore": {
    "users": {
        "schema": { "$ref": "#/entities/User" },
        "description": "List of user profiles."
    },
    "bookings": {
        "schema": { "$ref": "#/entities/Booking" },
        "description": "List of bookings."
    },
    "blocked_seats": {
         "schema": { "$ref": "#/entities/BlockedSeat" },
         "description": "List of currently locked seats on travels."
    },
    "coupons": {
         "schema": { "$ref": "#/entities/Coupon" },
         "description": "List of discount coupons and vouchers."
    },
    "configs": {
         "schema": { "$ref": "#/entities/Config" },
         "description": "Global configs."
    },
    "reviews": {
         "schema": { "$ref": "#/entities/Review" },
         "description": "Customer reviews for destinations."
    },
    "zalo_groups": {
         "schema": { "$ref": "#/entities/ZaloGroup" },
         "description": "List of public and admin-managed Zalo communities."
    }
  }
}
