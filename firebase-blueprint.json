{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing roles, points, and member personal details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phone": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "operator"] },
        "points": { "type": "number" },
        "gender": { "type": "string", "enum": ["male", "female", "other", "undisclosed"] },
        "birthDate": { "type": "string" },
        "address": { "type": "string" },
        "favPickup": { "type": "string" },
        "favDropoff": { "type": "string" },
        "avatarDataUrl": { "type": "string" },
        "welcomeBonusGranted": { "type": "boolean" },
        "welcomeBonusPoints": { "type": "number" },
        "welcomeBonusAt": { "type": "string" },
        "rewardedBookingIds": { "type": "array" },
        "completedBookingsCount": { "type": "number" },
        "usedCoupons": { "type": "array" }
      },
      "required": ["id", "role"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Ticket booking for limousine, combos, car",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "bookingDate": { "type": "string" },
        "travelDate": { "type": "string" },
        "passengerName": { "type": "string" },
        "passengerPhone": { "type": "string" },
        "totalPrice": { "type": "number" },
        "depositAmount": { "type": "number" },
        "operatorNotes": { "type": "string" },
        "driverName": { "type": "string" },
        "driverPhone": { "type": "string" },
        "vehiclePlate": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId", "type", "status"]
    },
    "BlockedSeat": {
      "title": "BlockedSeat",
      "description": "Information about locked seats by operator or booked",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tripId": { "type": "string" },
        "travelDate": { "type": "string" },
        "seatId": { "type": "string" },
        "customerPhone": { "type": "string" },
        "lockedBy": { "type": "string" }
      },
      "required": ["id", "tripId", "travelDate", "seatId"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Driver and vehicle fleet information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "plate": { "type": "string" },
        "carType": { "type": "string" },
        "note": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "busy", "off"] }
      },
      "required": ["id", "name", "phone", "plate"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional vouchers and discounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "discountPercentage": { "type": "number" },
        "title": { "type": "string" },
        "audience": { "type": "string" },
        "validFrom": { "type": "string" },
        "validUntil": { "type": "string" },
        "usageLimit": { "type": "number" },
        "usageCount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "isPublished": { "type": "boolean" }
      },
      "required": ["id", "code", "discountPercentage"]
    },
    "Restaurant": {
      "title": "Restaurant",
      "description": "Local restaurant and dining options",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "priceRange": { "type": "string" },
        "openHours": { "type": "string" },
        "isPartner": { "type": "boolean" },
        "commissionRate": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "FlowerSeason": {
      "title": "FlowerSeason",
      "description": "Seasonal flower bloom schedule and tips",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "timeRange": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string" },
        "published": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "Partner": {
      "title": "Partner",
      "description": "Tourism business partner directory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "contactPerson": { "type": "string" },
        "phone": { "type": "string" },
        "contractCode": { "type": "string" },
        "commissionRate": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "phone"]
    },
    "TaxiVehicle": {
      "title": "TaxiVehicle",
      "description": "Taxi and private vehicle fleet unit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "plate": { "type": "string" },
        "model": { "type": "string" },
        "seats": { "type": "number" },
        "provider": { "type": "string" },
        "phone": { "type": "string" },
        "basePrice": { "type": "number" },
        "status": { "type": "string" },
        "isVisible": { "type": "boolean" }
      },
      "required": ["id", "plate", "model", "seats"]
    },
    "TaxiRequest": {
      "title": "TaxiRequest",
      "description": "Customer taxi service booking request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "pickupPoint": { "type": "string" },
        "dropoffPoint": { "type": "string" },
        "seats": { "type": "number" },
        "travelDate": { "type": "string" },
        "quotedPrice": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "customerName", "customerPhone", "status"]
    },
    "MotorbikeVehicle": {
      "title": "MotorbikeVehicle",
      "description": "Motorbike rental fleet model",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "plate": { "type": "string" },
        "model": { "type": "string" },
        "type": { "type": "string", "enum": ["manual", "scooter"] },
        "totalQuantity": { "type": "number" },
        "availableQuantity": { "type": "number" },
        "dailyPrice": { "type": "number" },
        "status": { "type": "string" },
        "isVisible": { "type": "boolean" }
      },
      "required": ["id", "model", "type", "dailyPrice"]
    },
    "MotorbikeBookingRequest": {
      "title": "MotorbikeBookingRequest",
      "description": "Customer motorbike rental request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "bikeType": { "type": "string" },
        "quantity": { "type": "number" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "deliveryLocation": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "customerName", "customerPhone", "status"]
    },
    "AIKnowledgeItem": {
      "title": "AIKnowledgeItem",
      "description": "AI Travel Assistant FAQ knowledge base entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "topic": { "type": "string" },
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "number" }
      },
      "required": ["id", "question", "answer"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer reviews for destinations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "destinationId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "destinationId", "userName", "rating", "comment", "timestamp"]
    },
    "ZaloGroup": {
      "title": "ZaloGroup",
      "description": "Zalo community room information and invite link",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "topic": { "type": "string" },
        "zaloUrl": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "zaloUrl", "isActive"]
    }
  },
  "firestore": {
    "users": {
      "schema": { "$ref": "#/entities/User" },
      "description": "List of user profiles."
    },
    "bookings": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "List of bookings."
    },
    "blocked_seats": {
      "schema": { "$ref": "#/entities/BlockedSeat" },
      "description": "List of currently locked seats on travels."
    },
    "coupons": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "List of discount coupons and vouchers."
    },
    "restaurants": {
      "schema": { "$ref": "#/entities/Restaurant" },
      "description": "List of local restaurants and dining options."
    },
    "flower_seasons": {
      "schema": { "$ref": "#/entities/FlowerSeason" },
      "description": "Seasonal flower bloom schedule and tips."
    },
    "partners": {
      "schema": { "$ref": "#/entities/Partner" },
      "description": "List of tourism business partners."
    },
    "taxi_fleet": {
      "schema": { "$ref": "#/entities/TaxiVehicle" },
      "description": "Taxi and private vehicle fleet."
    },
    "taxi_requests": {
      "schema": { "$ref": "#/entities/TaxiRequest" },
      "description": "Customer taxi service requests."
    },
    "motorbike_fleet": {
      "schema": { "$ref": "#/entities/MotorbikeVehicle" },
      "description": "Motorbike rental fleet."
    },
    "motorbike_requests": {
      "schema": { "$ref": "#/entities/MotorbikeBookingRequest" },
      "description": "Customer motorbike rental requests."
    },
    "ai_faqs": {
      "schema": { "$ref": "#/entities/AIKnowledgeItem" },
      "description": "AI Travel Assistant FAQ knowledge base."
    },
    "reviews": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer reviews for destinations."
    },
    "zalo_groups": {
      "schema": { "$ref": "#/entities/ZaloGroup" },
      "description": "List of public and admin-managed Zalo communities."
    }
  }
}
