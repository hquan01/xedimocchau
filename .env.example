# DEV/VERCEL SERVER SECRETS — NEVER COMMIT REAL VALUES
# Data can live in a separate (preferably PRIVATE) GitHub repo.
# If stored in the public xedimocchau repo, the records remain ENCRYPTED.
GITHUB_DATA_REPO=YOUR_GITHUB_USERNAME/xedimocchau-data
GITHUB_DATA_BRANCH=main
GITHUB_DATA_TOKEN=PASTE_FINE_GRAINED_PAT_SERVER_ONLY
# base64(random 32 bytes) — command: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GITHUB_DATA_ENCRYPTION_KEY=BASE64_OF_32_RANDOM_BYTES
# at least 32 random characters. Generate separately; never reuse the encryption key.
GITHUB_SESSION_SECRET=GENERATE_A_DIFFERENT_RANDOM_LONG_SECRET
# Minimum 20 characters. Do not paste this password into any browser source code.
GITHUB_ADMIN_PASSWORD=STRONG_UNIQUE_ADMIN_PASSWORD
GITHUB_ADMIN_EMAIL=admin@example.com
# Optional Google Identity Services, requires configured domain and OAuth consent
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
GITHUB_GOOGLE_ADMIN_EMAILS=
VITE_GOOGLE_CLIENT_ID=
