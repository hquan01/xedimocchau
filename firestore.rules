rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('operator', false) == true ||
        request.auth.token.email == 'hquansl001@gmail.com' ||
        request.auth.token.email == 'nhaxe@mocchau.vn' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'customer') == 'operator' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'customer') == 'admin'
          )
        )
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for User profiles
    function isValidUser(data) {
      return data.get('id', '') is string && data.id.size() <= 128 &&
             data.get('role', '') in ['customer', 'operator', 'admin'] &&
             (data.get('phone', '') == '' || (data.phone is string && data.phone.size() <= 32)) &&
             (data.get('name', '') == '' || (data.name is string && data.name.size() <= 128)) &&
             (data.get('email', '') == '' || (data.email is string && data.email.size() <= 256)) &&
             (data.get('points', 0) is number && data.get('points', 0) >= 0);
    }

    // Validation for Booking documents
    function isValidBooking(data) {
      return data.get('id', '') is string && data.id.size() <= 128 &&
             data.get('type', '') is string && data.type.size() <= 64 &&
             data.get('status', '') is string && data.status.size() <= 64 &&
             (data.get('totalPrice', 0) is number);
    }

    // ==========================================
    // 1. Users collection: Secure Member Profile
    // ==========================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().role == 'customer' &&
          (incoming().get('points', 0) == 0 || incoming().get('points', 0) == 10)
        )
      );

      allow update: if isValidId(userId) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          isValidUser(incoming()) &&
          incoming().id == existing().id &&
          incoming().role == existing().role &&
          (
            // Action A: Edit profile personal information
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'phone', 'gender', 'birthDate', 'address',
              'favPickup', 'favDropoff', 'avatarDataUrl'
            ])
            ||
            // Action B: Spend points or add used coupon during booking creation
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['points', 'usedCoupons']) &&
              incoming().points <= existing().points
            )
            ||
            // Action C: First time welcome bonus repair
            (
              existing().get('welcomeBonusGranted', false) == false &&
              existing().get('points', 0) == 0 &&
              incoming().get('points', 0) == 10 &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'phone', 'points', 'welcomeBonusGranted', 'welcomeBonusPoints', 'welcomeBonusAt'
              ])
            )
          )
        )
      );

      allow delete: if isAdmin();
    }

    // ==========================================
    // 2. Bookings collection: Secure Order Data
    // ==========================================
    match /bookings/{bookingId} {
      allow get: if true;
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(bookingId) && isValidBooking(incoming()) && (
        isAdmin() ||
        (
          incoming().status == 'pending' &&
          (!isSignedIn() || incoming().get('userId', '') == request.auth.uid || incoming().get('userId', '') == '')
        )
      );

      allow update: if isValidId(bookingId) && (
        isAdmin() ||
        (
          isOwner(existing().get('userId', '')) &&
          incoming().status == 'cancelled' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        ) ||
        (
          // Customer reporting 50% deposit transfer
          incoming().diff(existing()).affectedKeys().hasOnly(['paymentReported', 'paymentReportedAt'])
        )
      );

      allow delete: if isAdmin();
    }

    // ==========================================
    // 3. Blocked Seats collection
    // ==========================================
    match /blocked_seats/{seatId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 4. Coupons collection: Advanced Voucher
    // ==========================================
    match /coupons/{couponId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['usageCount']) &&
        incoming().usageCount == existing().get('usageCount', 0) + 1
      );
    }

    // ==========================================
    // 5. Configs collection
    // ==========================================
    match /configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 6. Notifications collection
    // ==========================================
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || true;
    }

    // ==========================================
    // 7. Reviews collection
    // ==========================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() || true;
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 8. Content Ecosystem & Operator Management
    // ==========================================
    match /tour_combos/{comboId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /accommodations/{accId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /guide_articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /destinations/{destId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /restaurants/{restId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /flower_seasons/{seasonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /partners/{partnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /taxi_fleet/{taxiId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /taxi_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /motorbike_fleet/{bikeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /motorbike_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /ai_faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /zalo_groups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /community_posts/{postId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /site_content/{contentId} {
      allow read: if contentId == 'public';
      allow create, update, delete: if isAdmin() && contentId == 'public';
    }

    match /service_requests/{requestId} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }
  }
}
