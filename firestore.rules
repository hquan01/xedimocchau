rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.keys().hasAll(['email']) && (request.auth.token.email == 'hquansl001@gmail.com' || request.auth.token.email == 'nhaxe@mocchau.vn')) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'customer') == 'operator')
      );
    }

    function isHardcodedAdmin() {
      return isSignedIn() && request.auth.token.keys().hasAll(['email']) && (
        request.auth.token.email == 'hquansl001@gmail.com' || 
        request.auth.token.email == 'nhaxe@mocchau.vn'
      );
    }

    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().size() >= 2 &&
             data.get('id', '') is string && data.id.size() <= 128 &&
             data.get('role', '') is string && data.role.size() <= 64 &&
             (data.get('phone', '') == '' || (data.phone is string && data.phone.size() <= 32)) &&
             (data.get('name', '') == '' || (data.name is string && data.name.size() <= 128)) &&
             (data.get('email', '') == '' || (data.email is string && data.email.size() <= 256)) &&
             (data.get('points', 0) is number);
    }
    
    function isValidBooking(data) {
      return data.keys().size() >= 4 &&
             data.get('id', '') is string && data.id.size() <= 128 &&
             data.get('userId', '') is string && data.userId.size() <= 128 &&
             data.get('type', '') is string && data.type.size() <= 64 &&
             data.get('status', '') is string && data.status.size() <= 64 &&
             (data.get('totalPrice', 0) is number);
    }

    function isValidBlockedSeat(data) {
       return data.keys().size() >= 4 &&
              data.get('id', '') is string && data.id.size() <= 128 &&
              data.get('tripId', '') is string && data.tripId.size() <= 128 &&
              data.get('travelDate', '') is string && data.travelDate.size() <= 64 &&
              data.get('seatId', '') is string && data.seatId.size() <= 64;
    }

    // users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // bookings collection
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // blocked_seats collection
    match /blocked_seats/{seatId} {
      allow read, write: if true;
    }
    
    // configs collection (public read, public write for management persistence)
    match /configs/{configId} {
      allow read, write: if true;
    }

    // notifications collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // reviews collection
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    match /tour_combos/{comboId} {
      allow read, write: if true;
    }

    match /accommodations/{accId} {
      allow read, write: if true;
    }

    match /guide_articles/{articleId} {
      allow read, write: if true;
    }

    match /coupons/{couponId} {
      allow read, write: if true;
    }

    match /destinations/{destId} {
      allow read, write: if true;
    }

    match /zalo_groups/{groupId} {
      allow read, write: if true;
    }

    match /community_posts/{postId} {
      allow read, write: if true;
    }

    // New isolated features. The existing booking/users collections still require a separate safe migration.
    function hasAdminClaim() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.operator == true);
    }

    match /site_content/{contentId} {
      allow read: if contentId == 'public';
      allow create, update, delete: if hasAdminClaim() && contentId == 'public';
    }

    match /service_requests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
        'kind','customerName','customerPhone','status','createdAt','createdAtServer',
        'customerUid','quotedPrice','pickupPoint','dropoffPoint','seats','travelDate',
        'departureTime','bikeType','quantity','startDate','endDate','deliveryLocation','notes'
      ])
        && request.resource.data.kind in ['taxi','motorbike']
        && request.resource.data.status == 'pending'
        && request.resource.data.quotedPrice == 0
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.matches('^(\\+84|84|0)[35789][0-9]{8}$')
        && request.resource.data.createdAt is string
        && request.resource.data.createdAtServer == request.time
        && request.resource.data.customerUid is string
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && (
           (request.resource.data.kind == 'taxi'
            && request.resource.data.seats in [4,7,9,16]
            && request.resource.data.pickupPoint is string
            && request.resource.data.dropoffPoint is string
            && request.resource.data.travelDate is string)
           || (request.resource.data.kind == 'motorbike'
            && request.resource.data.quantity is int
            && request.resource.data.quantity >= 1
            && request.resource.data.quantity <= 20
            && request.resource.data.startDate is string
            && request.resource.data.endDate is string
            && request.resource.data.deliveryLocation is string)
        );
      allow get, list, update, delete: if hasAdminClaim();
    }
  }
}
